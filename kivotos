#!/usr/bin/env python3
"""kivotos: backups of service directories, with the rules for each service kept next to it.

Two backends, set with `backend` in the host config:
  restic (default)  kivotos runs restic on its own timer
  zfs               sanoid takes the snapshots; kivotos runs each service's dumps and hooks around them

  kivotos plan                             show what kivotos will do (no root needed)
  sudo kivotos units                       restic: (re)write the systemd service and timer from the config
                                           zfs: remove the restic units, check sanoid calls kivotos
restic:
  sudo kivotos run [SVC ...] [--dry-run]   back up every service (or only the ones named)
  sudo kivotos restic ARGS ...             any restic command against the repo
zfs:
  kivotos hook                             sanoid's pre/post_snapshot_script (reads SANOID_* env)
  sudo kivotos snapshot [LABEL]            hooks + a manual snapshot now (kept until you destroy it)
  sudo kivotos replicate [NAME ...]        run the [[zfs.replicate]] entries now (what their timers do)

Host settings:  /etc/kivotos/config.toml   (root-owned)
Service rules:  <source>/<svc>/kivotos.toml (optional, must be owned by the source's user or root)

Security model: kivotos runs as root so it can read files owned by container subuids and write
a repo the users can't touch. Service rules are only parsed as data. Every hook, dump and podman
call runs as the source's unprivileged `user` (per source, defaulting to the top-level one),
never as root, and only rules files owned by that user are honoured.
"""

import os
import pwd
import re
import shlex
import signal
import stat
import subprocess
import sys
import tomllib
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath

CONFIG = Path(os.environ.get("KIVOTOS_CONFIG", "/etc/kivotos/config.toml"))
RULES = "kivotos.toml"
UNITS = Path("/etc/systemd/system")
HOOK_TIMEOUT = 15 * 60
NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")
DATASET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]*(/[A-Za-z0-9_.:-]+)*$")

errors: list[str] = []


def log(msg: str) -> None:
    print(msg, flush=True)


def error(msg: str) -> None:
    errors.append(msg)
    print(f"!! {msg}", file=sys.stderr, flush=True)


def die(msg: str) -> None:
    print(f"kivotos: {msg}", file=sys.stderr)
    sys.exit(2)


# --- config -----------------------------------------------------------------------------------

@dataclass
class Dump:
    name: str
    command: str
    container: str | None
    file: str


@dataclass
class Service:
    name: str
    path: Path
    exclude: list[str] = field(default_factory=list)
    skip: bool = False
    stop: list[str] = field(default_factory=list)
    before: str | None = None
    after: str | None = None
    if_running: str | None = None
    dumps: list[Dump] = field(default_factory=list)
    has_rules: bool = False


def load_config() -> dict:
    try:
        with CONFIG.open("rb") as f:
            cfg = tomllib.load(f)
    except FileNotFoundError:
        die(f"{CONFIG} not found, run install.sh")
    except tomllib.TOMLDecodeError as e:
        die(f"{CONFIG}: {e}")
    cfg.setdefault("backend", "restic")
    if cfg["backend"] not in ("restic", "zfs"):
        die(f"{CONFIG}: backend must be 'restic' or 'zfs', not {cfg['backend']!r}")
    for key in ("repository", "password_file") if cfg["backend"] == "restic" else ():
        if key not in cfg:
            die(f"{CONFIG}: missing '{key}'")
    if "user" not in cfg:
        die(f"{CONFIG}: missing 'user'")
    zfs = cfg.setdefault("zfs", {})
    zfs["dump_on"] = str_list(zfs.get("dump_on", ["daily"]), "zfs.dump_on")
    names = set()
    for r in zfs.setdefault("replicate", []):
        if not isinstance(r, dict):
            die(f"{CONFIG}: [[zfs.replicate]] entries must be tables")
        if unknown := set(r) - {"name", "from", "to", "exclude", "schedule", "before"}:
            die(f"{CONFIG}: [[zfs.replicate]] unknown keys {sorted(unknown)}")
        for key in ("from", "to"):
            if not isinstance(r.get(key), str) or not DATASET_RE.match(r[key]):
                die(f"{CONFIG}: [[zfs.replicate]] needs '{key}' = a dataset name")
        try:
            r["exclude"] = str_list(r.get("exclude"), "exclude")
            r["before"] = str_list(r.get("before"), "before")
        except ValueError as e:
            die(f"{CONFIG}: [[zfs.replicate]] {r['from']}: {e}")
        for x in r["exclude"]:
            if not DATASET_RE.match(x) or not (x == r["from"] or x.startswith(r["from"] + "/")):
                die(f"{CONFIG}: [[zfs.replicate]] exclude {x!r} isn't a dataset under {r['from']}")
        r.setdefault("name", r["from"].replace("/", "-"))
        r.setdefault("schedule", "hourly")
        if not NAME_RE.match(r["name"]) or r["name"] in names:
            die(f"{CONFIG}: [[zfs.replicate]] name {r['name']!r} must be unique and match {NAME_RE.pattern}")
        names.add(r["name"])
    if not cfg.get("source"):
        die(f"{CONFIG}: no [[source]] entries")
    for src in cfg["source"]:
        for key in ("name", "path"):
            if not isinstance(src.get(key), str):
                die(f"{CONFIG}: a [[source]] is missing '{key}'")
        src.setdefault("user", cfg["user"])
        for u in {cfg["user"], src["user"]}:
            try:
                pwd.getpwnam(u)
            except KeyError:
                die(f"{CONFIG}: user {u!r} (source {src['name']}) doesn't exist on this machine")
    return cfg


def read_rules(path: Path, owner: str) -> dict | None:
    """Parse a service's kivotos.toml as data. Refuses symlinks, anything but a regular file, and
    files not owned by `owner` or root (their hooks run as `owner`, so only `owner` may write them)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise ValueError(f"can't open safely ({e.strerror})")
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise ValueError("not a regular file")
        if st.st_uid not in (0, pwd.getpwnam(owner).pw_uid):
            try:
                who = pwd.getpwuid(st.st_uid).pw_name
            except KeyError:
                who = f"uid {st.st_uid}"
            raise ValueError(f"owned by {who}, but this source's hooks run as {owner}; only {owner} or root may own it")
        try:
            return tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            raise ValueError(str(e))


def excludes_everything(pattern: str) -> bool:
    return str(PurePosixPath(pattern.strip())) in (".", "*", "**", "./*", "./**")


def anchor(base: Path, pattern: str) -> list[str]:
    """Exclude pattern -> restic patterns that can't reach outside `base`.
    './x' and 'a/b' (any slash) are relative to base; a bare 'name' matches at any depth under base."""
    p = pattern.strip()
    if not p or p.startswith("!") or ".." in PurePosixPath(p).parts:
        raise ValueError(f"bad exclude pattern {pattern!r} (no '!', no '..')")
    if p.startswith("/"):
        raise ValueError(f"exclude {pattern!r} looks absolute, write './{p.lstrip('/')}' for a path in this dir")
    rel = str(PurePosixPath(p))          # drops a leading './', duplicate and trailing slashes
    if p.startswith("./") or "/" in rel:
        return [f"{base}/{rel}"]
    return [f"{base}/{rel}", f"{base}/**/{rel}"]


def source_path(src: dict) -> Path:
    """'~' or '~/x' is the source user's home (not root's), '~name/x' is that user's home."""
    p = src["path"]
    if p.startswith("~"):
        name, _, rest = p[1:].partition("/")
        try:
            home = pwd.getpwnam(name or src["user"]).pw_dir
        except KeyError:
            die(f"{CONFIG}: source {src['name']}: no user {name!r} for {p!r}")
        p = home + ("/" + rest if rest else "")
    return Path(p)


def str_list(value, what: str) -> list[str]:
    if value is None:
        return []
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise ValueError(f"'{what}' must be a string or a list of strings")
    return value


def parse_service(path: Path, rules: dict) -> Service:
    svc = Service(name=path.name, path=path, has_rules=True)
    known = {"exclude", "skip", "stop", "hooks", "dump"}
    if unknown := set(rules) - known:
        raise ValueError(f"unknown keys {sorted(unknown)}")
    svc.exclude = str_list(rules.get("exclude"), "exclude")
    svc.skip = bool(rules.get("skip", False))
    svc.stop = str_list(rules.get("stop"), "stop")
    hooks = rules.get("hooks", {})
    if not isinstance(hooks, dict) or set(hooks) - {"before", "after", "if_running"}:
        raise ValueError("[hooks] takes only 'before', 'after' and 'if_running'")
    svc.before, svc.after, svc.if_running = hooks.get("before"), hooks.get("after"), hooks.get("if_running")
    for h in (svc.before, svc.after):
        if h is not None and not isinstance(h, str):
            raise ValueError("hooks must be strings")
    for d in rules.get("dump", []):
        name = d.get("name", "")
        if not NAME_RE.match(name):
            raise ValueError(f"dump name {name!r} must match {NAME_RE.pattern}")
        file = d.get("file", f"{name}.dump")
        if not NAME_RE.match(file):
            raise ValueError(f"dump file {file!r} must be a plain file name")
        if not isinstance(d.get("command"), str):
            raise ValueError(f"dump '{name}' needs a 'command'")
        svc.dumps.append(Dump(name, d["command"], d.get("container"), file))
    for c in svc.stop + [d.container for d in svc.dumps if d.container] + ([svc.if_running] if svc.if_running else []):
        if not NAME_RE.match(c):
            raise ValueError(f"bad container name {c!r}")
    return svc


def discover(source: Path, owner: str) -> tuple[list[Service], list[Path]]:
    """Each real (non-symlink) directory under the source is a service. Returns services + loose files."""
    services, loose = [], []
    for entry in sorted(os.scandir(source), key=lambda e: e.name.lower()):
        path = Path(entry.path)
        if entry.is_dir(follow_symlinks=False):
            try:
                rules = read_rules(path / RULES, owner)
                services.append(parse_service(path, rules) if rules is not None else Service(path.name, path))
            except ValueError as e:
                error(f"{path / RULES}: {e}. Backing up {path.name} with no rules")
                services.append(Service(path.name, path))
        elif entry.is_file(follow_symlinks=False):
            loose.append(path)
    return services, loose


# --- running things as the service user --------------------------------------------------------

class User:
    def __init__(self, name: str):
        pw = pwd.getpwnam(name)
        self.name, self.home = name, pw.pw_dir
        self.env = {
            "HOME": pw.pw_dir, "USER": name, "LOGNAME": name,
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "XDG_RUNTIME_DIR": f"/run/user/{pw.pw_uid}",
        }

    def argv(self, *cmd: str) -> list[str]:
        env = [f"{k}={v}" for k, v in self.env.items()]
        return ["runuser", "-u", self.name, "--", "env", "-i", *env, *cmd]

    def run(self, *cmd: str, cwd: Path | str = "/", quiet: bool = False) -> bool:
        try:
            r = subprocess.run(self.argv(*cmd), cwd=cwd, timeout=HOOK_TIMEOUT,
                               stdout=subprocess.DEVNULL if quiet else None)
            return r.returncode == 0
        except subprocess.TimeoutExpired:
            error(f"timed out: {shlex.join(cmd)}")
            return False

    def running(self, container: str) -> bool:
        r = subprocess.run(self.argv("podman", "inspect", "-f", "{{.State.Running}}", container),
                           cwd="/", capture_output=True, text=True)
        return r.stdout.strip() == "true"


# --- restic -------------------------------------------------------------------------------------

def restic_env(cfg: dict) -> None:
    if "repository" not in cfg or "password_file" not in cfg:
        die(f"{CONFIG}: no restic 'repository'/'password_file' set")
    os.environ["RESTIC_REPOSITORY"] = cfg["repository"]
    os.environ["RESTIC_PASSWORD_FILE"] = cfg["password_file"]
    os.environ["RESTIC_CACHE_DIR"] = cfg.get("cache_dir", "/var/cache/kivotos")


def restic(*args: str, cwd: Path | str = "/") -> bool:
    r = subprocess.run(["restic", *args], cwd=cwd)
    if r.returncode == 3:
        error(f"restic {args[0]}: some files couldn't be read (snapshot was still saved)")
    elif r.returncode != 0:
        error(f"restic {args[0]} failed (exit {r.returncode})")
    return r.returncode == 0


def backup_service(svc: Service, src: dict, user: User, dry: bool) -> None:
    tags = ["--tag", f"{src['name']},{svc.name}"]
    log(f"\n== {src['name']}/{svc.name}")
    if svc.skip:
        log("   skip = true, not backed up")
        return

    excludes = []
    for p in src.get("exclude", []) + svc.exclude:
        try:
            excludes += anchor(svc.path, p)
            log(f"   exclude {p}")
        except ValueError as e:
            error(f"{svc.name}: {e}")
    if any(excludes_everything(p) for p in svc.exclude):
        error(f"{svc.name}: excludes everything ({svc.path / RULES})")

    # 1. Dumps, while everything is still running
    for d in svc.dumps:
        if dry:
            log(f"   dump {d.name} (skipped in dry run)")
            continue
        if d.container and not user.running(d.container):
            log(f"   dump {d.name}: {d.container} isn't running, skipped")
            continue
        log(f"   dump {d.name} -> {svc.name}/{d.file}")
        cmd = ["podman", "exec", d.container, "sh", "-c", d.command] if d.container else ["sh", "-c", d.command]
        restic("backup", *tags, "--tag", "dump", "--stdin-filename", f"{svc.name}/{d.file}",
               "--stdin-from-command", "--", *user.argv(*cmd), cwd=svc.path)

    # 2. Quiesce: before hook, then stop containers
    stopped = []
    hooks = bool(svc.before or svc.after) and not dry
    if hooks and svc.if_running and not user.running(svc.if_running):
        log(f"   {svc.if_running} isn't running, hooks skipped")
        hooks = False
    if not dry:
        if svc.before and hooks:
            log(f"   before: {svc.before}")
            if not user.run("sh", "-c", svc.before, cwd=svc.path):
                error(f"{svc.name}: before hook failed, backing up anyway")
        for c in svc.stop:
            if user.running(c):
                log(f"   stopping {c}")
                if user.run("podman", "stop", c, quiet=True):
                    stopped.append(c)
                else:
                    error(f"{svc.name}: couldn't stop {c}, backing up while it runs")

    # 3. Files. Whatever happens, start containers again and run the after hook.
    try:
        args = ["backup", *tags, "--one-file-system", "--exclude-caches"]
        for e in excludes:
            args += ["--exclude", e]
        if dry:
            args += ["--dry-run", "-q"]
        restic(*args, str(svc.path))
    finally:
        for c in reversed(stopped):
            log(f"   starting {c}")
            if not user.run("podman", "start", c, quiet=True):
                error(f"{svc.name}: couldn't start {c} again! Run: podman start {c}")
        if svc.after and hooks:
            log(f"   after: {svc.after}")
            if not user.run("sh", "-c", svc.after, cwd=svc.path):
                error(f"{svc.name}: after hook failed")


# --- zfs -------------------------------------------------------------------------------------
# A ZFS snapshot is the whole dataset at one instant, so there is nothing to copy and nothing to
# exclude: `exclude` can't work (mount caches outside the snapshotted dataset instead) and `stop`
# is pointless. Dumps and hooks still matter, so they run around sanoid's snapshot.

SANOID_CONF = Path("/etc/sanoid/sanoid.conf")
DUMP_DIR = ".kivotos"


def dataset_of(path: Path) -> str | None:
    """The ZFS dataset `path` lives on, or None if it isn't on ZFS."""
    r = subprocess.run(["findmnt", "-n", "-o", "SOURCE,FSTYPE", "--target", str(path)],
                       capture_output=True, text=True)
    parts = r.stdout.split()
    return parts[0] if len(parts) == 2 and parts[1] == "zfs" else None


def zfs_sources(cfg: dict, dataset: str | None = None):
    """(src, user, root, dataset, services) for every source, or only those on `dataset`."""
    for src in cfg["source"]:
        root = source_path(src)
        if not root.is_dir():
            error(f"source {src['name']}: {root} doesn't exist")
            continue
        ds = dataset_of(root)
        if ds is None:
            error(f"source {src['name']}: {root} isn't on ZFS, so it isn't snapshotted")
            continue
        if dataset and ds != dataset:
            continue
        services, _ = discover(root, src["user"])
        yield src, User(src["user"]), root, ds, services


def zfs_dump(svc: Service, user: User, d: Dump) -> None:
    """Runs a dump as the service user, into <svc>/.kivotos/<file>, swapped in only when it succeeds."""
    if d.container and not user.running(d.container):
        log(f"   dump {d.name}: {d.container} isn't running, skipped (the last dump stays)")
        return
    log(f"   dump {d.name} -> {svc.name}/{DUMP_DIR}/{d.file}")
    cmd = ["podman", "exec", d.container, "sh", "-c", d.command] if d.container else ["sh", "-c", d.command]
    write = f'umask 077; mkdir -p {DUMP_DIR} && "$@" > "{DUMP_DIR}/$0.tmp" && mv -f "{DUMP_DIR}/$0.tmp" "{DUMP_DIR}/$0"'
    if not user.run("sh", "-c", write, d.file, *cmd, cwd=svc.path):
        user.run("rm", "-f", f"{DUMP_DIR}/{d.file}.tmp", cwd=svc.path)
        error(f"{svc.name}: dump {d.name} failed")


def hooks_apply(svc: Service, user: User) -> bool:
    if not (svc.before or svc.after):
        return False
    if svc.if_running and not user.running(svc.if_running):
        log(f"   {svc.if_running} isn't running, hooks skipped")
        return False
    return True


def zfs_pre(cfg: dict, dataset: str | None, types: list[str]) -> None:
    dumps = bool(set(types) & set(cfg["zfs"]["dump_on"])) or not types
    for src, user, _, ds, services in zfs_sources(cfg, dataset):
        for svc in services:
            if svc.skip or not (svc.dumps or svc.before):
                continue
            log(f"== {ds}: {src['name']}/{svc.name}")
            if dumps:
                for d in svc.dumps:
                    zfs_dump(svc, user, d)
            if svc.before and hooks_apply(svc, user):
                log(f"   before: {svc.before}")
                if not user.run("sh", "-c", svc.before, cwd=svc.path):
                    error(f"{svc.name}: before hook failed, snapshotting anyway")


def zfs_post(cfg: dict, dataset: str | None) -> None:
    for src, user, _, ds, services in zfs_sources(cfg, dataset):
        for svc in services:
            if svc.skip or not svc.after or not hooks_apply(svc, user):
                continue
            log(f"== {ds}: {src['name']}/{svc.name}\n   after: {svc.after}")
            if not user.run("sh", "-c", svc.after, cwd=svc.path):
                error(f"{svc.name}: after hook failed")


def finish(what: str) -> None:
    if errors:
        print(f"\nkivotos {what} finished with {len(errors)} problem(s):", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        sys.exit(1)


def cmd_hook(cfg: dict) -> None:
    """sanoid's pre_snapshot_script/post_snapshot_script. sanoid sets SANOID_SCRIPT (pre/post),
    SANOID_TARGET (the dataset) and SANOID_TYPES (e.g. "daily,hourly")."""
    if os.geteuid() != 0:
        die("hook runs as root, from sanoid")
    if cfg["backend"] != "zfs":
        die("hook is for backend = \"zfs\"")
    stage, target = os.environ.get("SANOID_SCRIPT"), os.environ.get("SANOID_TARGET")
    if stage not in ("pre", "post") or not target:
        die("hook must be run by sanoid (SANOID_SCRIPT and SANOID_TARGET not set)")
    types = [t for t in os.environ.get("SANOID_TYPES", "").split(",") if t]
    if stage == "pre":
        zfs_pre(cfg, target, types)
    else:
        zfs_post(cfg, target)
    finish(f"{stage}-snapshot hook")


def cmd_snapshot(cfg: dict, label: str | None) -> None:
    if os.geteuid() != 0:
        die("snapshot needs root: sudo kivotos snapshot [LABEL]")
    if cfg["backend"] != "zfs":
        die("snapshot is for backend = \"zfs\"; use `kivotos run`")
    if label is not None and not NAME_RE.match(label):
        die(f"label must match {NAME_RE.pattern}")
    stamp = subprocess.run(["date", "+%Y-%m-%d_%H:%M:%S"], capture_output=True, text=True).stdout.strip()
    datasets = sorted({ds for _, _, _, ds, _ in zfs_sources(cfg)})
    zfs_pre(cfg, None, [])
    try:
        for ds in datasets:
            snap = f"{ds}@kivotos_{label + '_' if label else ''}{stamp}"
            if subprocess.run(["zfs", "snapshot", snap]).returncode == 0:
                log(f"snapshot {snap}")
            else:
                error(f"zfs snapshot {snap} failed")
    finally:
        zfs_post(cfg, None)
    if not errors:
        log(f"\nManual snapshots aren't pruned by sanoid. Remove one with: sudo zfs destroy <dataset>@<name>")
    finish("snapshot")


def sanoid_sections() -> dict[str, dict[str, str]]:
    """sanoid.conf as {section: {key: value}}, or {} if it can't be read."""
    try:
        text = SANOID_CONF.read_text()
    except OSError:
        return {}
    sections, cur = {}, None
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("[") and line.endswith("]"):
            cur = sections.setdefault(line[1:-1], {})
        elif cur is not None and "=" in line:
            k, v = (x.strip() for x in line.split("=", 1))
            cur[k] = v
    return sections


def sanoid_policy(dataset: str, sections: dict) -> tuple[str, dict] | None:
    """The sanoid section that applies to `dataset` (its own, or a recursive ancestor's) and its
    settings with the template filled in. None if sanoid doesn't manage it."""
    parts = dataset.split("/")
    for i in range(len(parts), 0, -1):
        name = "/".join(parts[:i])
        sec = sections.get(name)
        if sec is None or (name != dataset and sec.get("recursive", "no") == "no"):
            continue
        conf = {}
        for t in sec.get("use_template", "").split(","):
            conf.update(sections.get(f"template_{t.strip()}", {}))
        conf.update(sec)
        return name, conf
    return None


def describe_policy(dataset: str, sections: dict) -> str:
    pol = sanoid_policy(dataset, sections)
    if pol is None:
        return "not in sanoid.conf: no snapshots, nothing pruned"
    name, c = pol
    keep = " ".join(f"{c[k]}{k[0]}" for k in ("frequently", "hourly", "daily", "weekly", "monthly", "yearly")
                    if c.get(k, "0") not in ("0", ""))
    take = "takes snapshots" if c.get("autosnap", "yes") == "yes" else "only prunes"
    if c.get("autoprune", "yes") != "yes":
        take += ", never prunes"
    via = "" if name == dataset else f" (via [{name}])"
    return f"{take}, keeps {keep or 'none'}{via}"


def sanoid_hooked(dataset: str) -> bool:
    """Whether sanoid.conf has a section for `dataset` that calls kivotos hook before and after."""
    found = sanoid_sections().get(dataset, {})
    return all("kivotos hook" in found.get(k, "") for k in ("pre_snapshot_script", "post_snapshot_script"))


# --- replication --------------------------------------------------------------------------------

def config_is_root_only() -> bool:
    """`before` commands run as root, so the config must be writable by root alone."""
    st = CONFIG.stat()
    return st.st_uid == 0 and not st.st_mode & 0o022


def replicate(r: dict) -> None:
    log(f"== replicate {r['name']}: {r['from']} -> {r['to']}")
    for cmd in r["before"]:
        log(f"   before: {cmd}")
        if subprocess.run(["sh", "-c", cmd]).returncode != 0:
            error(f"replicate {r['name']}: before command failed: {cmd}")
    args = ["syncoid", "--recursive", "--no-sync-snap", "--create-bookmark", "--quiet"]
    args += [f"--exclude-datasets=^{re.escape(x)}(/|$)" for x in r["exclude"]]
    env = dict(os.environ, LC_ALL="C")   # perl's locale warnings otherwise
    if subprocess.run([*args, r["from"], r["to"]], env=env).returncode != 0:
        error(f"replicate {r['name']}: syncoid {r['from']} -> {r['to']} failed")


def cmd_replicate(cfg: dict, only: list[str]) -> None:
    if os.geteuid() != 0:
        die("replicate needs root: sudo kivotos replicate")
    if cfg["backend"] != "zfs":
        die("replicate is for backend = \"zfs\"")
    entries = [r for r in cfg["zfs"]["replicate"] if not only or r["name"] in only]
    if missing := set(only) - {r["name"] for r in entries}:
        die(f"no [[zfs.replicate]] named {', '.join(sorted(missing))}")
    if any(r["before"] for r in entries) and not config_is_root_only():
        die(f"{CONFIG} must be owned by root and writable only by root, because `before` runs as root")
    for r in entries:
        replicate(r)
    finish("replicate")


def plan_zfs(cfg: dict) -> None:
    sections = sanoid_sections()
    log(f"backend zfs: sanoid snapshots, kivotos runs dumps (on {'/'.join(cfg['zfs']['dump_on'])} snapshots) and hooks")
    if not sections:
        log(f"  !! can't read {SANOID_CONF}")
    for r in cfg["zfs"]["replicate"]:
        log(f"\n[replicate {r['name']}] {r['from']} -> {r['to']}, {r['schedule']}"
            + (f", except {', '.join(r['exclude'])}" if r["exclude"] else ""))
        for cmd in r["before"]:
            log(f"  before (as root): {cmd}")
        log(f"  {r['from']}: {describe_policy(r['from'], sections)}")
        log(f"  {r['to']}: {describe_policy(r['to'], sections)}")
        pol = sanoid_policy(r["to"], sections)
        if pol is None or pol[1].get("autoprune", "yes") != "yes":
            log(f"  !! nothing prunes {r['to']}, so it keeps every snapshot it receives, forever")
        elif pol[1].get("autosnap", "yes") == "yes":
            log(f"  !! sanoid also takes its own snapshots of {r['to']}; set autosnap = no there")
        if not (UNITS / f"kivotos-replicate-{r['name']}.timer").exists():
            log(f"  !! no timer yet: sudo kivotos units")
    for src, _, root, ds, services in zfs_sources(cfg):
        hooked = sanoid_hooked(ds)
        log(f"\n[{src['name']}] {root} on {ds}, hooks run as {src['user']}\n  {ds}: {describe_policy(ds, sections)}"
            + ("" if hooked else f"\n  !! {SANOID_CONF} doesn't call `kivotos hook` for [{ds}], so none of this runs"))
        if src.get("exclude"):
            log(f"  !! source exclude {src['exclude']} does nothing on zfs")
        for s in services:
            if not s.has_rules:
                continue
            if s.skip:
                log(f"  {s.name}: skip = true does nothing on zfs (the whole dataset is snapshotted)")
                continue
            bits = []
            if s.dumps: bits.append("dump " + ", ".join(f"{d.name} -> {DUMP_DIR}/{d.file}" for d in s.dumps))
            if s.before or s.after: bits.append("hooks" + (f" (if {s.if_running} runs)" if s.if_running else ""))
            log(f"  {s.name}: " + "; ".join(bits or ["rules file, nothing that applies on zfs"]))
            if s.exclude:
                log(f"    !! exclude {s.exclude} does nothing on zfs: mount those paths outside {root}"
                    " (e.g. /var/cache/containers or /tank/cache) instead")
            if s.stop:
                log(f"    stop {s.stop} is ignored on zfs: snapshots are instant, nothing needs stopping")
    finish("plan")


def cmd_run(cfg: dict, only: list[str], dry: bool) -> None:
    if os.geteuid() != 0:
        die("run needs root: sudo kivotos run")
    if cfg["backend"] == "zfs":
        die("backend is zfs: sanoid takes the snapshots and calls `kivotos hook`. "
            "For one right now: sudo kivotos snapshot [LABEL]")
    restic_env(cfg)
    seen = set()
    for src in cfg["source"]:
        user = User(src["user"])
        root = source_path(src)
        if not root.is_dir():
            error(f"source {src['name']}: {root} doesn't exist")
            continue
        services, loose = discover(root, src["user"])
        for svc in services:
            if only and svc.name not in only:
                continue
            seen.add(svc.name)
            backup_service(svc, src, user, dry)
        if loose and not only:
            log(f"\n== {src['name']} (loose files: {', '.join(p.name for p in loose)})")
            restic("backup", "--tag", f"{src['name']},_files", *(["--dry-run", "-q"] if dry else []),
                   *map(str, loose))
    if missing := set(only) - seen:
        error(f"no such service: {', '.join(sorted(missing))}")

    if not dry and not only:
        r = cfg.get("retention", {})
        keep = []
        for k in ("hourly", "daily", "weekly", "monthly", "yearly"):
            if r.get(k):
                keep += [f"--keep-{k}", str(r[k])]
        if keep:
            log("\n== retention")
            restic("forget", "--group-by", "host,paths", *keep, "--prune")
        log("\n== check")
        restic("check")

    if errors:
        print(f"\nkivotos finished with {len(errors)} problem(s):", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        sys.exit(1)
    log("\nkivotos: all good")


def cmd_plan(cfg: dict) -> None:
    if cfg["backend"] == "zfs":
        return plan_zfs(cfg)
    log(f"repo {cfg['repository']}, schedule {cfg.get('schedule', '(none)')}")
    for src in cfg["source"]:
        root = source_path(src)
        services, loose = discover(root, src["user"])
        log(f"\n[{src['name']}] {root}, hooks run as {src['user']}"
            + (f"  (all: exclude {src['exclude']})" if src.get("exclude") else ""))
        for s in services:
            if not s.has_rules:
                log(f"  {s.name}")
                continue
            if s.skip:
                log(f"  {s.name}: SKIPPED")
                continue
            bits = []
            if s.exclude: bits.append(f"exclude {s.exclude}")
            if s.dumps: bits.append("dump " + ", ".join(f"{d.name}" + (f" ({d.container})" if d.container else "") for d in s.dumps))
            if s.before: bits.append("before hook" + (f" (if {s.if_running} runs)" if s.if_running else ""))
            if s.stop: bits.append(f"stop {s.stop}")
            if s.after: bits.append("after hook")
            log(f"  {s.name}: " + "; ".join(bits or ["rules file, nothing special"]))
        if loose:
            log(f"  (loose files) {', '.join(p.name for p in loose)}")
    if errors:
        sys.exit(1)


def write_replicate_units(cfg: dict) -> None:
    """One kivotos-replicate-<name>.service + .timer per [[zfs.replicate]]; stale ones are removed."""
    head = f"# Written by `kivotos units` from {CONFIG}. Edit the config, not this file.\n"
    exe = Path(sys.argv[0]).resolve()
    want = set()
    for r in cfg["zfs"]["replicate"]:
        if subprocess.run(["systemd-analyze", "calendar", r["schedule"]], capture_output=True).returncode != 0:
            die(f"[[zfs.replicate]] {r['name']}: schedule {r['schedule']!r} isn't a valid systemd OnCalendar expression")
        unit = f"kivotos-replicate-{r['name']}"
        want.add(unit)
        (UNITS / f"{unit}.service").write_text(
            head + f"[Unit]\nDescription=kivotos: replicate {r['from']} to {r['to']}\n"
            "Requires=zfs.target\nAfter=zfs.target sanoid.service\n\n"
            f"[Service]\nType=oneshot\nExecStart={exe} replicate {r['name']}\nNice=10\nIOSchedulingClass=idle\n")
        (UNITS / f"{unit}.timer").write_text(
            head + f"[Unit]\nDescription=kivotos: replicate {r['from']} to {r['to']}\n\n"
            f"[Timer]\nOnCalendar={r['schedule']}\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n")
    stale = {p.name.rsplit(".", 1)[0] for p in UNITS.glob("kivotos-replicate-*.timer")} - want
    for unit in stale:
        subprocess.run(["systemctl", "disable", "--now", f"{unit}.timer"], capture_output=True)
        for ext in ("service", "timer"):
            (UNITS / f"{unit}.{ext}").unlink(missing_ok=True)
        log(f"Removed {unit} (no longer in the config)")
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    if want:
        subprocess.run(["systemctl", "enable", "--now", *(f"{u}.timer" for u in sorted(want))], check=True)
        subprocess.run(["systemctl", "list-timers", *(f"{u}.timer" for u in sorted(want)), "--no-pager"])


def cmd_units(cfg: dict) -> None:
    if os.geteuid() != 0:
        die("units needs root: sudo kivotos units")
    if cfg["backend"] == "zfs":
        units = [UNITS / "kivotos.service", UNITS / "kivotos.timer"]
        if any(u.exists() for u in units):
            subprocess.run(["systemctl", "disable", "--now", "kivotos.timer"], capture_output=True)
            for u in units:
                u.unlink(missing_ok=True)
            subprocess.run(["systemctl", "daemon-reload"], check=True)
            log("Removed kivotos.service and kivotos.timer (backend is zfs, sanoid does the scheduling)")
        write_replicate_units(cfg)
        for ds in sorted({ds for _, _, _, ds, _ in zfs_sources(cfg)}):
            if sanoid_hooked(ds):
                log(f"sanoid calls kivotos for [{ds}]")
            else:
                log(f"!! Add to [{ds}] in {SANOID_CONF}:\n"
                    f"    pre_snapshot_script = {Path(sys.argv[0]).resolve()} hook\n"
                    f"    post_snapshot_script = {Path(sys.argv[0]).resolve()} hook\n"
                    "    force_post_snapshot_script = yes\n    script_timeout = 900")
        finish("units")
        return
    sched = cfg.get("schedule")
    if not sched:
        die(f"{CONFIG}: no 'schedule'")
    if subprocess.run(["systemd-analyze", "calendar", sched], capture_output=True).returncode != 0:
        die(f"schedule {sched!r} isn't a valid systemd OnCalendar expression")
    delay = cfg.get("randomized_delay", "0")
    head = f"# Written by `kivotos units` from {CONFIG}. Edit the config, not this file.\n"
    # Don't run against an empty mountpoint: wait for the sources and a local repo to be mounted
    mounts = [str(source_path(s)) for s in cfg["source"]]
    if cfg["repository"].startswith("/"):
        mounts.append(cfg["repository"])
    exe = Path(sys.argv[0]).resolve()
    (UNITS / "kivotos.service").write_text(
        head + "[Unit]\nDescription=kivotos backups\n"
        f"RequiresMountsFor={' '.join(shlex.quote(m) for m in mounts)}\n\n"
        f"[Service]\nType=oneshot\nExecStart={exe} run\nNice=10\nIOSchedulingClass=idle\n")
    (UNITS / "kivotos.timer").write_text(
        head + "[Unit]\nDescription=kivotos backups\n\n"
        f"[Timer]\nOnCalendar={sched}\nRandomizedDelaySec={delay}\nPersistent=true\n\n"
        "[Install]\nWantedBy=timers.target\n")
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "enable", "--now", "kivotos.timer"], check=True)
    subprocess.run(["systemctl", "list-timers", "kivotos.timer", "--no-pager"])


def main() -> None:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # quiet exit when piped into head/less
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    cfg = load_config()
    if cmd == "run":
        dry = "--dry-run" in rest
        cmd_run(cfg, [a for a in rest if a != "--dry-run"], dry)
    elif cmd == "plan":
        cmd_plan(cfg)
    elif cmd == "units":
        cmd_units(cfg)
    elif cmd == "hook":
        cmd_hook(cfg)
    elif cmd == "replicate":
        cmd_replicate(cfg, rest)
    elif cmd == "snapshot":
        cmd_snapshot(cfg, rest[0] if rest else None)
    elif cmd == "restic":
        restic_env(cfg)
        os.execvp("restic", ["restic", *rest])
    else:
        die(f"unknown command {cmd!r}, see kivotos --help")


if __name__ == "__main__":
    main()
