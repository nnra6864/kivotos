#!/usr/bin/env bash
# Backs up /home/nn/Containers to the restic repo on tank. Runs as root (container files belong to subuids).
#   sudo restic-containers           take a backup now (this is what the timer runs)
#   sudo restic-containers <args>    run any restic command on the repo: snapshots, ls latest, restore, stats ...
set -euo pipefail
set -a; . /etc/restic/containers.env; set +a

[ $# -gt 0 ] && exec restic "$@"

cd /
as_nn() { runuser -u nn -- env XDG_RUNTIME_DIR=/run/user/1000 "$@"; }
running() { [ "$(as_nn podman inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

# Minecraft: flush the world to disk and pause autosave so the copy is consistent
mc_resume() { as_nn podman exec nn-survival rcon-cli save-on >/dev/null || echo "!! Couldn't turn saving back on in nn-survival: run  podman exec nn-survival rcon-cli save-on" >&2; }
if running nn-survival; then
    if as_nn podman exec nn-survival rcon-cli save-off >/dev/null; then
        trap mc_resume EXIT
        as_nn podman exec nn-survival rcon-cli save-all flush >/dev/null || echo "!! save-all flush failed, the world copy may be slightly behind" >&2
    else
        echo "!! rcon-cli save-off failed, backing up the world while it is live" >&2
    fi
fi

# 1. The Containers directory (excludes in /etc/restic/containers.exclude)
restic backup --tag containers --one-file-system --exclude-caches \
    --exclude-file /etc/restic/containers.exclude /home/nn/Containers

# Saving can resume as soon as the files are copied
if trap -p EXIT | grep -q mc_resume; then mc_resume; trap - EXIT; fi

# 2. Postgres as a dump: copying the live data dir can give a corrupt database
if running postgres-db; then
    restic backup --tag postgres --stdin-filename postgres-all.sql --stdin-from-command -- \
        runuser -u nn -- env XDG_RUNTIME_DIR=/run/user/1000 \
        podman exec postgres-db sh -c 'pg_dumpall -U "${POSTGRES_USER:-postgres}"'
else
    echo "!! postgres-db isn't running, skipping the database dump" >&2
fi

# 3. Retention (per tag), then a quick integrity check of the repo metadata
restic forget --group-by host,tags --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
restic check
